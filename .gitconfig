[mergetool "nvim"]
	cmd = nvim -f -c \"Gdiff\" \"$MERGED\"
[pull]
	rebase = true
[init]
	defaultBranch = main
[commit]
	template = ~/.gitmessage
	gpgsign = true
[gpg]
	program = gpg2
[push]
	autoSetupRemote = true
[core]
	excludesFile = ~/.gitignore
	autocrlf = false
[maintenance]
	repo = /Users/dave/dotfiles/Repos/znap
	repo = /Users/dave/dotfiles/Repos/marlonrichert/zsh-autocomplete
[safe]
